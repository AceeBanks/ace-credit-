# G0-B9-C14 — environment config template.
# Secrets are NEVER stored here; only references to the secret store.
# Copy to .env.local for LOCAL development (dev-only dummy values).

# --- environment ---
GRANT_ENV=local            # local | test | staging | production

# --- database (canonical state) ---
GRANT_DB_URL=sqlite:///./dev.db
# GRANT_DB_URL=postgres://user:pass@host/grantdb

# --- model gateway (provider adapter) ---
# Dev-only dummy; production credentials come from the secret store (C21),
# never from env files committed to the repo.
GRANT_MODEL_PROFILE=pp_openrouter_dev
GRANT_MODEL_ID=minimax/minimax-m3:free
# GRANT_OPENROUTER_API_KEY=<from secret store, DEV_RUNTIME_ONLY>

# --- object storage (immutable payloads) ---
GRANT_OBJECT_STORE=local    # local | s3
# GRANT_S3_BUCKET=...
# GRANT_S3_REGION=...

# --- observability ---
GRANT_LOG_LEVEL=info

# --- submission is structurally disabled; no submission flag exists ---
