{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/g0/model/model_response.schema.json",
  "title": "ModelResponse",
  "description": "G0-B7-PHASE-B — typed model response contract. The response remains attributable to the exact model/config that produced it and never contains credential material.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_response_id",
    "model_request_id",
    "provider",
    "model_id",
    "output_text_or_structured_payload",
    "finish_reason",
    "input_tokens",
    "output_tokens",
    "total_tokens",
    "latency_ms",
    "generated_at",
    "audit_ref"
  ],
  "properties": {
    "model_response_id": {"type": "string", "minLength": 1},
    "model_request_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "model_version_if_available": {"type": ["string", "null"]},
    "output_text_or_structured_payload": {
      "type": ["string", "object", "array", "number", "boolean", "null"]
    },
    "finish_reason": {"type": ["string", "null"]},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "total_tokens": {"type": "integer", "minimum": 0},
    "latency_ms": {"type": "number", "minimum": 0},
    "cost_usd_if_known": {"type": ["number", "null"]},
    "provider_request_id": {"type": ["string", "null"]},
    "retry_count": {"type": "integer", "minimum": 0},
    "safety_or_filter_metadata": {"type": ["object", "null"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "audit_ref": {"type": "string", "minLength": 1}
  }
}
