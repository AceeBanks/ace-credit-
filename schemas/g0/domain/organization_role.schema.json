{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OrganizationRole",
  "description": "B2.C3 core entity \u2014 OrganizationRole (identity prefix role_)",
  "type": "object",
  "properties": {
    "role_id": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "role_type": {
      "type": "string",
      "enum": [
        "applicant",
        "fiscal_sponsor",
        "funder",
        "partner",
        "recipient"
      ]
    },
    "target_ref": {
      "type": "string"
    },
    "valid_from": {
      "type": "string",
      "format": "date"
    },
    "valid_to": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "role_id",
    "organization_id",
    "role_type"
  ],
  "additionalProperties": false
}
