{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpportunityRevision",
  "description": "B2.C3 core entity \u2014 OpportunityRevision (identity prefix opp_rev_)",
  "type": "object",
  "properties": {
    "revision_id": {
      "type": "string"
    },
    "opportunity_id": {
      "type": "string"
    },
    "revision_number": {
      "type": "integer"
    },
    "terms_hash": {
      "type": "string"
    },
    "deadline": {
      "type": "string",
      "format": "date"
    },
    "funding_ceiling": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d{1,2})?$",
      "description": "fixed-point decimal as string; float money is prohibited (B2.C12)"
    },
    "material_change": {
      "type": "boolean"
    }
  },
  "required": [
    "revision_id",
    "opportunity_id",
    "revision_number",
    "terms_hash",
    "material_change"
  ],
  "additionalProperties": false
}
