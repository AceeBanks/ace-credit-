{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/g0/policy/authority_grant.schema.json",
  "title": "G0 Authority Grant (e.g. worker TaskContract capability grant)",
  "type": "object",
  "required": ["grant_id", "granted_to_actor_id", "granted_by_actor_id",
               "capability_ids", "tenant_id", "issued_at", "expires_at", "status"],
  "additionalProperties": false,
  "properties": {
    "grant_id": {"type": "string"},
    "granted_to_actor_id": {"type": "string"},
    "granted_by_actor_id": {"type": "string"},
    "capability_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "tenant_id": {"type": "string"},
    "project_id": {"type": ["string", "null"]},
    "task_contract_ref": {"type": ["string", "null"]},
    "max_authority_level": {"enum": ["L0", "L1", "L2", "L3", "L4", "L5"], "description": "Grant can never exceed granter's ceiling; evaluator re-checks."},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "status": {"enum": ["ACTIVE", "EXPIRED", "REVOKED"]}
  },
  "properties_note": "Grants are additive scope narrowing only: a grant may restrict, never extend beyond the registry and the granter's own ceiling."
}
