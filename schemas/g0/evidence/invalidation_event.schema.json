{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://grant-sector.g0/schemas/evidence/invalidation_event.schema.json",
  "title": "InvalidationEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["invalidation_id", "changed_upstream_ref", "change_class", "affected_downstream_refs", "required_action", "priority", "resolved"],
  "properties": {
    "invalidation_id": {"type": "string", "minLength": 1},
    "changed_upstream_ref": {"type": "string", "minLength": 1},
    "change_class": {"type": "string", "enum": ["MATERIAL", "NONMATERIAL", "DELETION", "NEW_REVISION"]},
    "affected_downstream_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "required_action": {"type": "string", "enum": ["RECOMPUTE", "REVIEW", "FLAG_STALE", "NONE"]},
    "priority": {"type": "string", "enum": ["P0", "P1", "P2"]},
    "resolved": {"type": "boolean", "default": false}
  }
}
