{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://grant-sector.g0/schemas/evidence/graph_projection_event.schema.json",
  "title": "GraphProjectionEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["projection_event_id", "source_refs", "projection_target", "projection_schema_version", "created_at", "status"],
  "properties": {
    "projection_event_id": {"type": "string", "minLength": 1},
    "source_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "projection_target": {"type": "string", "minLength": 1},
    "projection_schema_version": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"type": "string", "enum": ["COMPLETE", "IN_PROGRESS", "STALE", "FAILED"]}
  }
}
