{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://grant-sector.g0/schemas/evidence/support_assertion.schema.json",
  "title": "SupportAssertion",
  "type": "object",
  "additionalProperties": false,
  "required": ["support_id", "claim_ref", "evidence_ref", "support_type", "created_at", "method"],
  "properties": {
    "support_id": {"type": "string", "minLength": 1},
    "claim_ref": {"type": "string", "minLength": 1},
    "evidence_ref": {"type": "string", "minLength": 1},
    "support_type": {
      "type": "string",
      "enum": ["DIRECT", "CORROBORATING", "DERIVED", "USER_ATTESTED", "ADMIN_VERIFIED", "OFFICIAL_RECORD", "STATISTICAL_CONTEXT"]
    },
    "quality": {"$ref": "evidence_quality.schema.json"},
    "created_at": {"type": "string", "format": "date-time"},
    "method": {"type": "string", "minLength": 1}
  }
}
