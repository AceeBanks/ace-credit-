{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/g0/evaluation/metric_bundle.schema.json",
  "title": "MetricBundle",
  "description": "G0-B7-C2 — multi-dimensional metric results; never collapsed into one opaque score (EVAL-LAW-013).",
  "type": "object",
  "additionalProperties": false,
  "required": ["metric_bundle_id", "dimensions", "created_at"],
  "properties": {
    "metric_bundle_id": {"type": "string", "minLength": 1},
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension_id", "value", "direction"],
        "properties": {
          "dimension_id": {"type": "string"},
          "value": {},
          "direction": {"type": "string", "enum": ["higher_is_better", "lower_is_better"]},
          "units": {"type": ["string", "null"]},
          "collection": {"type": ["string", "null"]},
          "gate": {"type": "string", "enum": ["HARD", "OPTIMIZE"]},
          "confidence": {"type": ["number", "null"]},
          "sample_size": {"type": ["integer", "null"]}
        }
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "content_hash": {"type": "string"}
  }
}
