{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/g0/security/credential_reference.schema.json",
  "title": "CredentialReference",
  "description": "G0-B6-C8 — opaque reference to a vault secret; agents/services never see raw secrets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "credential_ref_id",
    "provider",
    "tenant_id",
    "owner_principal_or_service",
    "allowed_capabilities",
    "allowed_destinations",
    "status",
    "expires_at",
    "rotation_policy"
  ],
  "properties": {
    "credential_ref_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "owner_principal_or_service": {"type": "string", "minLength": 1},
    "allowed_capabilities": {"type": "array", "items": {"type": "string"}},
    "allowed_destinations": {"type": "array", "items": {"type": "string"}},
    "status": {"type": "string", "enum": ["ACTIVE", "REVOKED", "EXPIRED", "ROTATING"]},
    "expires_at": {"type": "string", "format": "date-time"},
    "rotation_policy": {"type": "string", "minLength": 1}
  }
}
