{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/g0/security/tool_definition.schema.json",
  "title": "ToolDefinition",
  "description": "G0-B6-C9 — governed, versioned tool metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tool_id",
    "version",
    "provider",
    "capability_ids",
    "side_effect_class",
    "network_destinations",
    "credential_requirements",
    "read_write_class",
    "status"
  ],
  "properties": {
    "tool_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "capability_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "input_schema_ref": {"type": "string"},
    "output_schema_ref": {"type": "string"},
    "side_effect_class": {"type": "string", "minLength": 1},
    "network_destinations": {"type": "array", "items": {"type": "string"}},
    "credential_requirements": {"type": "array", "items": {"type": "string"}},
    "resource_types": {"type": "array", "items": {"type": "string"}},
    "read_write_class": {"type": "string", "minLength": 1},
    "idempotency_support": {"type": "boolean", "default": false},
    "timeout_policy": {"type": "string"},
    "rate_limit_policy": {"type": "string"},
    "audit_class": {"type": "string"},
    "status": {"type": "string", "minLength": 1}
  }
}
