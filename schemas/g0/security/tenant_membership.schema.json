{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/g0/security/tenant_membership.schema.json",
  "title": "TenantMembership",
  "description": "G0-B6-C3 — commercial multi-tenant membership with product roles (not Book 1 authority levels).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "membership_id",
    "tenant_id",
    "principal_id",
    "role_ids",
    "status",
    "valid_from",
    "valid_to"
  ],
  "properties": {
    "membership_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "principal_id": {"type": "string", "minLength": 1},
    "role_ids": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "status": {"type": "string", "minLength": 1},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_to": {"type": "string", "format": "date-time"}
  }
}
