# .env.example — Grant Agent (branch grant-sector-g1-production)
#
# Copy this file to `.env` in the repository root and fill in values.
# The start_grant_agent.ps1 launcher reads `.env` (if present) and exports
# the variables to the API process. NEVER commit a real `.env`.
#
# The Grant Agent runs fully WITHOUT any key in deterministic/deliberate dev
# mode. A key is required ONLY for live model generation (AUTO/MANUAL produce),
# which routes through the governed G0 Model Gateway -> OpenRouter.

# --- Governance / live model (OPTIONAL) -------------------------------------
# Required for live-model drafting (AUTO and MANUAL produce). Without it the
# API intentionally fails closed with 503 MODEL_CONFIGURATION_REQUIRED — it
# never silently substitutes the deterministic skeleton as client output.
# Service  : OpenRouter (aggregator used by the governed G0 Model Gateway)
# Required : No (deterministic/dev mode works without it)
# Scope    : opens external network + uses free-tier model lanes. Treat as secret.
OPENROUTER_API_KEY=

# --- Storage (OPTIONAL, defaults below) -------------------------------------
# Path to the SQLite dev database. Default is <repo>/var/g1.db.
# Omit to use the default. (Production canonical storage is Postgres, G1.10.)
G1_DB=

# --- Web client (OPTIONAL) ---------------------------------------------------
# Backend the Next.js UI proxies /api/* to. Default is http://localhost:8000.
# API_URL=http://localhost:8000